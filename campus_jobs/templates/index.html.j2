<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="每日更新的2027届央国企、重点子公司与外企官方校园招聘信息">
  <title>{{ title }}</title>
  <style>
    :root{color-scheme:light;--ink:#14213d;--muted:#64748b;--line:#e2e8f0;--brand:#075985;--brand2:#0e7490;--soft:#ecfeff;--ok:#047857;--dead:#b91c1c}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--ink);background:#f8fafc}
    main{max-width:1380px;margin:auto;padding:34px 22px 64px}.hero{background:linear-gradient(125deg,#082f49,#155e75);color:white;border-radius:22px;padding:30px;box-shadow:0 16px 35px #0c4a6e22}
    h1{margin:0 0 9px;font-size:clamp(28px,4vw,46px);letter-spacing:-.03em}.subtitle{color:#cffafe;line-height:1.65}.updated{color:#a5f3fc;margin-top:8px;font-size:13px}
    .stats{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:12px;margin:20px 0}.stat,.panel{background:white;border:1px solid var(--line);border-radius:16px;box-shadow:0 2px 8px #0f172a0a}
    .stat{padding:17px}.stat b{font-size:28px;display:block}.stat span{font-size:13px;color:var(--muted)}.panel{padding:17px}
    .health{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:14px;padding:11px 13px;border-radius:10px;background:var(--soft);color:#155e75;font-size:13px}
    .filters{display:grid;grid-template-columns:2fr repeat(6,1fr);gap:9px;margin-bottom:14px}input,select{width:100%;min-height:42px;border:1px solid #cbd5e1;border-radius:9px;background:#fff;padding:9px 10px;color:var(--ink)}
    .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--muted);font-size:14px;margin-bottom:10px}.download,.apply{display:inline-block;text-decoration:none;border-radius:8px;white-space:nowrap}
    .download{color:var(--brand);border:1px solid #bae6fd;padding:8px 11px}.apply{color:white;background:var(--brand2);padding:9px 12px}
    .table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:1120px}th,td{padding:13px 10px;border-top:1px solid var(--line);text-align:left;vertical-align:top;font-size:14px}th{color:#475569;font-size:12px;position:sticky;top:0;background:white}
    .company{font-weight:750}.parent,.summary,small{color:var(--muted)}.title{min-width:260px}.summary{margin-top:5px;max-width:430px;line-height:1.5}.badge{display:inline-block;border-radius:99px;background:#f1f5f9;padding:3px 8px;font-size:12px;white-space:nowrap}.official{color:var(--ok);background:#ecfdf5}.foreign{color:#6d28d9;background:#f5f3ff}.expired{color:var(--dead);background:#fef2f2}.today{outline:2px solid #67e8f9;outline-offset:-2px}.hidden{display:none}
    .empty{text-align:center;color:var(--muted);padding:28px}footer{color:var(--muted);font-size:13px;line-height:1.7;margin-top:18px}
    @media(max-width:980px){main{padding:18px 11px 40px}.hero{padding:23px 18px}.stats{grid-template-columns:1fr 1fr}.filters{grid-template-columns:1fr 1fr}.filters input{grid-column:1/-1}.health{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body><main>
  <header class="hero">
    <h1>{{ title }}</h1>
    <div class="subtitle">只收录可验证的企业官网、官方招聘平台与官方公众号公开信息 · 按招聘批次展示</div>
    <div class="updated">最近生成：{{ generated_at }}</div>
  </header>
  <section class="stats">
    <div class="stat"><b>{{ stats.today }}</b><span>今日新增</span></div>
    <div class="stat"><b>{{ stats.total }}</b><span>累计官方公告</span></div>
    <div class="stat"><b>{{ stats.companies }} / {{ target_companies }}</b><span>已有公告 / 监测企业</span></div>
    <div class="stat"><b>{{ stats.active }}</b><span>招聘进行中</span></div>
  </section>
  <section class="panel">
    <div class="health">
      <span><b>采集健康状态：</b>{% if health.source_attempts %}{{ health.source_successes }}/{{ health.source_attempts }} 个官方来源可访问{% else %}等待首次官方采集{% endif %}</span>
      {% if health.failed_sources %}<span>{{ health.failed_sources|length }} 个来源将在下次任务重试</span>{% endif %}
    </div>
    <div class="filters">
      <input id="keyword" type="search" placeholder="搜索企业、母公司或公告">
      <select id="ownership"><option value="">全部企业类型</option><option>央国企</option><option>外企</option></select>
      <select id="parent"><option value="">全部母公司</option></select>
      <select id="campaign"><option value="">全部招聘类型</option></select>
      <select id="location"><option value="">全部地点</option></select>
      <select id="date"><option value="">全部发布日期</option><option value="7">近 7 天</option><option value="30">近 30 天</option></select>
      <select id="status"><option value="">全部状态</option><option value="active">招聘中</option><option value="expired">已失效</option><option value="unknown">状态未知</option></select>
    </div>
    <div class="toolbar"><span>当前显示 <b id="visible-count">{{ jobs|length }}</b> 条</span><a class="download" href="jobs.csv">下载 CSV</a></div>
    <div class="table-wrap"><table>
      <thead><tr><th>企业</th><th>招聘公告</th><th>类型 / 地点</th><th>发布时间</th><th>来源与状态</th><th>官方链接</th></tr></thead>
      <tbody>
      {% for job in jobs %}
        <tr class="job-row{% if job.first_seen_at[:10] == today %} today{% endif %}"
            data-search="{{ (job.company ~ ' ' ~ job.parent_company ~ ' ' ~ job.title ~ ' ' ~ job.summary)|lower }}"
            data-ownership="{{ job.ownership_type }}" data-parent="{{ job.parent_company }}"
            data-campaign="{{ job.campaign }}" data-location="{{ job.locations }}"
            data-published="{{ job.published_at }}" data-status="{{ job.active_status }}">
          <td><span class="company">{{ job.company }}</span><br><span class="badge {{ 'foreign' if job.ownership_type == '外企' else '' }}">{{ job.ownership_type }}</span>{% if job.parent_company and job.parent_company != job.company %}<div class="parent">隶属 {{ job.parent_company }}</div>{% endif %}</td>
          <td class="title"><b>{{ job.title }}</b>{% if job.summary %}<div class="summary">{{ job.summary }}</div>{% endif %}{% if job.first_seen_at[:10] == today %}<span class="badge official">今日新增</span>{% endif %}</td>
          <td><span class="badge">{{ job.campaign }}</span><br>{{ job.locations }}</td>
          <td>{{ job.published_at or '未注明' }}{% if job.deadline %}<br><small>截止：{{ job.deadline }}</small>{% endif %}</td>
          <td><span class="badge official">{{ job.source_type }}</span><br><span class="badge {{ 'expired' if job.active_status == 'expired' else '' }}">{{ active_label(job.active_status) }}</span></td>
          <td><a class="apply" href="{{ job.official_url }}" target="_blank" rel="noopener noreferrer">前往官方页面</a></td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    <div id="empty" class="empty{% if jobs %} hidden{% endif %}">暂无符合条件的官方招聘公告。</div>
  </section>
  <footer>本站只聚合公开招聘信息，不收集求职者个人信息。所有公告均应在投递前再次核对企业域名、招聘对象、截止时间及隐私条款。无法验证主体身份的搜索线索不会公开展示。</footer>
</main>
<script>
  const rows=[...document.querySelectorAll('.job-row')], ids=['keyword','ownership','parent','campaign','location','date','status'];
  const controls=Object.fromEntries(ids.map(id=>[id,document.getElementById(id)]));
  function addOptions(id,key){const s=controls[id];[...new Set(rows.map(r=>r.dataset[key]).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'zh-CN')).forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;s.appendChild(o)})}
  addOptions('parent','parent');addOptions('campaign','campaign');addOptions('location','location');
  function filter(){const q=controls.keyword.value.toLowerCase(),days=Number(controls.date.value||0),now=Date.now();let count=0;rows.forEach(r=>{const age=r.dataset.published?((now-new Date(r.dataset.published).getTime())/86400000):Infinity;const show=(!q||r.dataset.search.includes(q))&&(!controls.ownership.value||r.dataset.ownership===controls.ownership.value)&&(!controls.parent.value||r.dataset.parent===controls.parent.value)&&(!controls.campaign.value||r.dataset.campaign===controls.campaign.value)&&(!controls.location.value||r.dataset.location===controls.location.value)&&(!days||age<=days)&&(!controls.status.value||r.dataset.status===controls.status.value);r.classList.toggle('hidden',!show);if(show)count++});document.getElementById('visible-count').textContent=count;document.getElementById('empty').classList.toggle('hidden',count!==0)}
  ids.forEach(id=>controls[id].addEventListener(id==='keyword'?'input':'change',filter));
</script></body></html>
